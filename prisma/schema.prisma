// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User{
  id String @id @default(auto()) @db.ObjectId @map("_id") 
  name String @unique
  password String
  authType authRole @default(USER)
  isBoarded Boolean @default(false)
  onBoarding onBoarding?
  products Products[]
  cart Cart[]
  orders Orders[]
}

model onBoarding {
  id String @id @default(auto()) @db.ObjectId @map("_id") 
  name String
  email String @unique
  address String
  phone String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId @unique
  completed Boolean @default(false)
}

model Products{
  id String @id @default(auto()) @db.ObjectId @map("_id") 
  product_name String
  product_about String
  product_price String
  product_image String
  product_category productCategory @default(HOME)

  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId 
  
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @default(now()) @map("updatedAt")

  cart Cart[]
}

model Cart { 
  id String @id @default(auto()) @db.ObjectId @map("_id") 
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  products Products @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String @db.ObjectId

  quantity String @default("1")
  price String 
  addedAt DateTime @default(now()) @map("addedAt")
  updatedAt DateTime @default(now()) @map("updatedAt")
  orders Orders[]
}

model Orders{
  id String @id @default(auto()) @db.ObjectId @map("_id") 
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId 

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId String @db.ObjectId

  totalPrice String 
  
  orderDate DateTime @default(now()) @map("orderDate")
  status String @default("PENDING") @map("status")
}


enum authRole{
  USER
  ADMIN
}

enum productCategory{
  ELECTRONICS
  FURNITURE
  HOME
  CLOTHING
  SPORTS
  TOYS
  BOOKS
  FASHION
  GROCERY
  HOME_APPLIANCES
}

